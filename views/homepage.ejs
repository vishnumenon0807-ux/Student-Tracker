<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Tracker Dashboard</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f6f9;
}

/* Navbar */

.navbar{
    background:#6c3df4;
    color:white;
    padding:20px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    color:white;
    font-size:32px;
    font-weight:bold;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    text-decoration:none;
    color:white;
    font-size:18px;
    font-weight:500;
    padding:8px 12px;
    border-radius:6px;
    transition:0.3s;
}

.nav-links a:hover{
    background:white;
    color:#6c3df4;
}

.profile-btn{
    background-color:red;
    color:white;
    padding:10px 20px;
    border:none;
    border-radius:6px;
    cursor:pointer;
    font-weight:bold;
}

/* Main Content */

.container{
    width:90%;
    margin:auto;
    margin-top:30px;
}

.welcome{
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0px 2px 10px rgba(0,0,0,0.1);
}

.welcome h2{
    color:#6c3df4;
}

.cards{
    margin-top:25px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.card{
    background:white;
    padding:25px;
    border-radius:15px;
    text-align:center;
    box-shadow:0px 2px 10px rgba(0,0,0,0.1);
}

.card h3{
    color:#6c3df4;
    margin-bottom:10px;
}

.card p{
    font-size:30px;
    font-weight:bold;
}

/* Sections */

.section{
    background:white;
    margin-top:25px;
    padding:25px;
    border-radius:15px;
    box-shadow:0px 2px 10px rgba(0,0,0,0.1);
}

.section h2{
    color:#6c3df4;
    margin-bottom:15px;
}

.assignment,
.course{
    display:flex;
    justify-content:space-between;
    padding:15px;
    border-bottom:1px solid #ddd;
}

.assignment:last-child,
.course:last-child{
    border-bottom:none;
}

.empty{
    padding:15px;
    color:gray;
}

.empty a{
    color:#6c3df4;
}

.footer{
    margin-top:30px;
    text-align:center;
    padding:20px;
    color:gray;
}

</style>
</head>

<body>

<div class="navbar">

    <h1>Student Tracker</h1>

    <div class="nav-links">
        <a href="/homepage">Dashboard</a>
        <a href="/grades">Grades</a>
        <a href="/timetable">Timetable</a>
        <a href="/assignment">Assignment</a>
        <a href="/attendance">Attendance</a>
    </div>

    <button class="profile-btn" onClick="window.location.href='/logout'">Log Out</button>

</div>

<!-- Main Container -->

<div class="container">

    <!-- Welcome -->

    <div class="welcome">

        <h2>
            Welcome <%= name %>
        </h2>

        <br>

        <p>
            Track your academic progress and stay organized.
        </p>

    </div>

    <!-- Cards -->

    <div class="cards">

        <div class="card">
            <h3>CGPA</h3>
            <p>
                <%= cgpa==null ? "-" : Number(cgpa).toFixed(2) %>
            </p>
        </div>

        <div class="card">
            <h3>Attendance</h3>
            <p>
                <%= attendance==null ? "-" : attendance.toFixed(0)+"%" %>
            </p>
        </div>

        <div class="card">
            <h3>Courses</h3>
            <p><%= courses %></p>
        </div>

        <div class="card">
            <h3>Pending Tasks</h3>
            <p><%= pending %></p>
        </div>

    </div>

    <!-- Assignments -->

    <div class="section">

        <h2>Upcoming Assignments</h2>

        <% if(assignments.length===0){ %>

            <div class="empty">
                No upcoming assignments.
                <a href="/assignment">Add one</a>
            </div>

        <% } %>

        <% assignments.forEach(a=>{ %>

            <div class="assignment">

                <span><%= a.assignment %> (<%= a.subject %>)</span>

                <span>
                    <%= new Date(a.deadline).getDate() %>
                    <%= new Date(a.deadline).toLocaleString("en-US",{month:"long"}) %>
                </span>

            </div>

        <% }) %>

    </div>

    <!-- Courses -->

    <div class="section">

        <h2>Current Courses</h2>

        <% if(subjects.length===0){ %>

            <div class="empty">
                No subjects added yet.
                <a href="/attendance">Add your subjects</a>
            </div>

        <% } %>

        <% subjects.forEach(s=>{ %>

            <div class="course">

                <span><%= s.subject %></span>

                <span>
                    <%= s.total>0
                        ? ((s.attended/s.total)*100).toFixed(0)+"%"
                        : "-" %>
                </span>

            </div>

        <% }) %>

    </div>

</div>

<div class="footer">
    Student Tracker Dashboard 
</div>

</body>
</html>
